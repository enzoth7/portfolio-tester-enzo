{
  "info": {
    "name": "API-QA-Collection",
    "_postman_id": "api-qa-collection-id",
    "description": "Colección simple para portfolio API QA (ReqRes, Fake Store, Postman Echo).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "ReqRes",
      "item": [
        {
          "name": "List users (page=2)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{reqres_base}}/api/users?page=2"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"JSON válido\", () => pm.expect(json).to.be.an(\"object\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get user by id (2)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{reqres_base}}/api/users/2"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Tiene id o data.id\", () => pm.expect(json.id || (json.data && json.data.id)).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "accept",
                "value": "application/json"
              },
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{reqres_base}}/api/users"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"morpheus\", \"job\": \"leader\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200/201/204\", () => pm.expect([200,201,204]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update user (2)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "accept",
                "value": "application/json"
              },
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{reqres_base}}/api/users/2"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"neo\", \"job\": \"chosen\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200/201/204\", () => pm.expect([200,201,204]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete user (2)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{reqres_base}}/api/users/2"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200/201/204\", () => pm.expect([200,201,204]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
